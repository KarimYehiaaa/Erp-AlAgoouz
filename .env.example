# أمان: لا تسمح للتطوير المحلي باستخدام قاعدة بعيدة إلا بقرار صريح.
ALLOW_REMOTE_DB_IN_DEVELOPMENT=false
# الترحيلات المعلّقة على قاعدة بعيدة لا تُطبّق عند إعادة تشغيل API.
# بعد إيقاف النسخ والتحقق من نسخة قابلة للاستعادة استخدم: npm run migrate-supabase -w backend -- --allow-remote
# للتطوير المحلي على قاعدة مشتركة قديمة فقط: true يتجاوز الترحيلات ومزامنة الفواتير تلقائياً.
# لا تستخدمه في الإنتاج؛ تأكد أن مخطط قاعدة البيانات متوافق مع إصدار التطبيق.
ERP_SKIP_STARTUP_MIGRATIONS=false
NODE_ENV=development
PORT=3000
HTTPS_PORT=3443
DB_HOST=localhost
DB_PORT=5432
# نحافظ على المنفذ المختار: Supabase 5432 للجلسة المستمرة و6543 للمعاملات السحابية.
# auto يكتشف Supabase 6543؛ اضبط transaction صراحةً لو كان وسيط معاملات آخر.
DB_POOL_MODE=auto
# اتصالات الأعمال: افتراضي 10 للقاعدة الحلقية و3 للبعيدة أو Vercel، قابل للتحديد من 1 إلى 50.
# احسبها مع اتصالات التنسيق أدناه ضمن حد القاعدة المشتركة لجميع الخوادم.
DB_POOL_MAX=
# اتصالات مستقلة لتنسيق الاستعادة: افتراضي 10 لاتصال قاعدة loopback و3 للبعيدة أو Vercel.
# يمكن تحديد العدد من 1 إلى 10؛ الخادم المحلي المتصل بـSupabase يستخدم الافتراضي 3.
# احسبها مع اتصالات الأعمال والطلبات الحصرية ضمن حد خطة قاعدة البيانات.
DB_MAINTENANCE_POOL_MAX=
DB_POOL_IDLE_TIMEOUT_MS=
DATABASE_URL=
# تحقق شهادة الاتصال إلزامي عند استخدام TLS؛ لا تستخدم sslmode/no-verify في الرابط.
# شهادة CA موثوقة بصيغة PEM، بمسار مطلق أو نسبة إلى backend (اختياري إذا كانت موثوقة في النظام).
DB_SSL_CA_FILE=
DB_SSL=
DB_SSL_REJECT_UNAUTHORIZED=true
# Supabase endpoints use the bundled public root CA by default; this overrides it.
DB_NAME=bin_al_ajouz
DB_USER=erp_user
DB_PASSWORD=replace_with_strong_database_password
# اتركه فارغًا محليًا. الإنتاج يرفض الفراغ؛ أدخل سرًا عشوائيًا خاصًا عبر مدير الأسرار.
JWT_SECRET=
# مفتاح عشوائي منفصل اختياري؛ عند تركه فارغًا يشتق النظام مفتاحًا منفصلًا من JWT_SECRET.
JWT_REFRESH_SECRET=
# مدة توكن الوصول (افتراضي 2h) — التجديد الصامت يتم عبر refresh token
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
# أصل السيرفر المحلي نفسه مسموح؛ واجهة LAN على عنوان أو منفذ آخر تحتاج إضافتها هنا.
# أصول شبكة داخلية مسموحة صراحةً (مفصولة بفواصل) — لا يوجد wildcard افتراضياً
CORS_LAN_ORIGINS=
CORS_ALLOW_VERCEL_PREVIEWS=false
TRUST_PROXY=
# مطلوب لتشفير النسخ الاحتياطية — ولّده بـ: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
BACKUP_ENCRYPTION_KEY=
CORS_ORIGIN=http://localhost
COMPANY_NAME=Bin Al-Ajouz

# ─── الذكاء الاصطناعي (Gemini AI Copilot) ───
# احصل على مفتاح مجاني من: https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# الموديل الافتراضي (يمكن تغييره)
GEMINI_MODEL=gemini-3.5-flash

# ─── بوت تليجرام (Telegram Notifications & Commands) ───
# أنشئ بوت من @BotFather على تليجرام واحصل على التوكن
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# Chat ID الخاص بالمالك أو المجموعة — ارسل /start للبوت ثم استخدم @userinfobot
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
TELEGRAM_ALLOWED_CHATS=
# Secret-token for the Telegram webhook header. Generate a random value of 32-256 characters
# using A-Z, a-z, 0-9, underscore or hyphen; configure it in both this server and Telegram.
# The webhook is disabled until this value is configured.
TELEGRAM_WEBHOOK_SECRET=

# سر تشغيل مجدول الأتمتة الخارجي — قيمة عشوائية طويلة، لا تُحفظ في Git
AUTOMATION_CRON_SECRET=

# Test/maintenance toggles.
AUTO_BACKUP_DIR=
AUTO_BACKUP_SKIP_CLEANUP=0
AUTO_BACKUP_SKIP_EXTERNAL=0
REDIS_URL=
SENTRY_DSN=
ALERT_DISCORD_WEBHOOK_URL=
LOCAL_EXTERNAL_BACKUP_PATH=
# اختياري لتوليد PDF من API: مسار Chrome/Chromium/Edge أو اسم أمره في PATH.
# يلزم تثبيت المتصفح في بيئة التشغيل؛ ترفض الخدمة المسار الصريح غير الصالح.
CHROME_PATH=
SUPPRESS_CONFIG_LOG=

# أدوات PostgreSQL المحلية والاختبارات فقط؛ لا تضع أسرار الإنتاج هنا.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
ADMIN_RESET_PASSWORD=
RUN_DB_INTEGRATION_TESTS=0
