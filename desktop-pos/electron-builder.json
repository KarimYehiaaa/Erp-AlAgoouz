{
  "appId": "com.alagoouz.pos",
  "productName": "AlAgoouz-POS",
  "directories": {
    "output": "release"
  },
  "publish": null,
  "icon": "public/icon.ico",
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "executableName": "AlAgoouz-POS",
    "artifactName": "AlAgoouz-POS-Setup-${version}.${ext}",
    "signExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "بن العجوز POS"
  }
}
