{
  "_comment": "قسم crons يستدعي مسار نبض المجدول مرة يوميًا (الحد الأدنى المتاح في خطة Hobby). معظم المهام تُشغَّل تراجعيًا عبر نافذة البحث 35 يومًا في المجدول فلا تُفوَّت. على خطة Pro يمكن رفع التكرار إلى كل دقيقة باستبدال الجدول بـ * * * * * لدقة جدولة كاملة.",
  "crons": [
    { "path": "/api/automation/scheduler/tick", "schedule": "0 21 * * *" }
  ],
  "buildCommand": "cd frontend && npx vite build --outDir ../dist",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*": {
      "maxDuration": 30,
      "includeFiles": "{backend/**,shared/**}"
    }
  },
  "rewrites": [
    { "source": "/api/v1/(.*)", "destination": "/api/index" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/v1/(.*)", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
