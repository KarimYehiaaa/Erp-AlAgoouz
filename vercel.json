{
  "version": 2,
  "builds": [
    {
      "src": "backend/src/index.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/backend/src/index.js"
    },
    {
      "source": "/assets/:path*",
      "destination": "/frontend/dist/assets/:path*"
    },
    {
      "source": "/logo.png",
      "destination": "/frontend/dist/logo.png"
    },
    {
      "source": "/manifest.json",
      "destination": "/frontend/dist/manifest.json"
    },
    {
      "source": "/sw.js",
      "destination": "/frontend/dist/sw.js"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/dist/index.html"
    }
  ]
}
