[TEMPLATE]
PORT=3000
NODE_ENV=development
# منفذ خادم HTTPS المحلي (يُستخدم فقط عند وجود backend/certs/key.pem + cert.pem)
HTTPS_PORT=3443

# ── قاعدة البيانات ──
# رابط اتصال موحد (بديل عن المتغيرات المفككة) — Supabase/Render إلخ
DATABASE_URL=
# أمان: لا تسمح للتطوير المحلي باستخدام قاعدة بعيدة إلا بقرار صريح.
ALLOW_REMOTE_DB_IN_DEVELOPMENT=false
# للتطوير المحلي على قاعدة مشتركة قديمة فقط: true يتجاوز الترحيلات ومزامنة الفواتير تلقائياً.
# لا تستخدمه في الإنتاج؛ تأكد أن مخطط قاعدة البيانات متوافق مع إصدار التطبيق.
ERP_SKIP_STARTUP_MIGRATIONS=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bin_al_ajouz
DB_USER=erp_user
DB_PASSWORD=replace_with_strong_password
# فرض SSL لقاعدة البيانات + التحقق من الشهادة (افتراضي: تلقائي حسب نوع المضيف)
DB_SSL=
DB_SSL_REJECT_UNAUTHORIZED=
# PostgreSQL pool sizing; keep this within the Supabase pooler plan limit.
DB_POOL_MAX=
DB_POOL_IDLE_TIMEOUT_MS=

# ── Redis / الطوابير (اختياري) ──
# بدون REDIS_URL يعمل النظام كاملاً بدون BullMQ (النسخ الاحتياطي يعمل مباشرة)
REDIS_URL=

# ── مراقبة الأخطاء (اختياري) ──
SENTRY_DSN=

# ── تنبيهات خارجية (اختيارية) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHATS=
# Optional only while the Telegram webhook endpoint is unused. Set a random 32-256 character
# value using A-Z, a-z, 0-9, underscore or hyphen, and configure the same value in Telegram's
# X-Telegram-Bot-Api-Secret-Token webhook setting. Webhook requests fail closed when unset.
TELEGRAM_WEBHOOK_SECRET=
ALERT_DISCORD_WEBHOOK_URL=

# ── أدوات ──
# اختياري لتوليد PDF من API: مسار Chrome/Chromium/Edge أو اسم أمره في PATH.
# يلزم تثبيت المتصفح في بيئة التشغيل؛ ترفض الخدمة المسار الصريح غير الصالح.
CHROME_PATH=
# مسار محلي إضافي لنسخ النسخ الاحتياطية التلقائية
LOCAL_EXTERNAL_BACKUP_PATH=
# =1 لإسكات سجل إعدادات الإقلاع في التطوير
SUPPRESS_CONFIG_LOG=

# ── أدوات قاعدة البيانات المحلية (setup/reset scripts) ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
ADMIN_RESET_PASSWORD=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=bin_al_ajouz
DB_USER=erp_user
DB_PASSWORD=replace_with_strong_password

# اتركه فارغًا محليًا. الإنتاج يرفض الفراغ؛ أدخل سرًا عشوائيًا خاصًا عبر مدير الأسرار.
JWT_SECRET=
# مفتاح عشوائي منفصل اختياري؛ عند تركه فارغًا يشتق النظام مفتاحًا منفصلًا من JWT_SECRET.
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# مطلوب لتشفير النسخ الاحتياطية — ولّده بـ: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
BACKUP_ENCRYPTION_KEY=

CORS_ORIGIN=http://localhost:3000
# السماح بمعاينات فروع Vercel (*.vercel.app) — معطل افتراضياً لأمان CORS
CORS_ALLOW_VERCEL_PREVIEWS=false
# ثقة البروكسي: 1 خلف Vercel تلقائياً؛ اضبط true فقط إذا كان API خلف proxy عكسي
# اتركه فارغاً في التشغيل المباشر (يمنع تزوير X-Forwarded-For لتجاوز rate-limit)
TRUST_PROXY=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

COMPANY_NAME=Bin Al-Ajouz

# ── الذكاء الاصطناعي (المساعد الذكي / الدردشة التفاعلية) ──
# مفتاح Google Gemini API — احصل عليه مجانًا من:
#   https://aistudio.google.com/apikey
# ثم الصقه هنا (بدون علامات اقتباس). بدون هذا المفتاح يعمل النظام كاملًا
# ما عدا المساعد الذكي والدردشة التفاعلية.
GEMINI_API_KEY=
# النموذج المستخدم (اختياري — الافتراضي gemini-2.5-flash).
GEMINI_MODEL=gemini-3.5-flash

# Set to 1 only when running DB-mutating integration tests against a disposable database.
RUN_DB_INTEGRATION_TESTS=0

# Optional backup controls for tests/maintenance.
AUTO_BACKUP_DIR=
AUTO_BACKUP_SKIP_CLEANUP=0
AUTO_BACKUP_SKIP_EXTERNAL=0
