{
  "name": "bin-al-ajouz-desktop-pos",
  "version": "1.0.15",
  "description": "نظام نقاط البيع والكاشير المكتبي المتكامل - بن العجوز ERP",
  "author": "بن العجوز ERP",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-http-cache-semantics.mjs",
    "dev": "vite",
    "build": "node scripts/run-desktop-build.mjs renderer",
    "preview": "vite preview",
    "test": "vitest run tests",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "electron:dev": "vite",
    "build:installer": "node scripts/run-desktop-build.mjs installer",
    "electron:build": "node scripts/run-desktop-build.mjs all"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KarimYehiaaa/Erp-AlAgoouz.git"
  },
  "dependencies": {
    "@lucide/vue": "^1.17.0",
    "axios": "^1.20.0",
    "electron-updater": "^6.8.9",
    "pinia": "^3.0.0",
    "vue": "^3.5.6",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.4",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "html2pdf.js": "^0.14.0",
    "http-cache-semantics": "4.3.0",
    "qrcode": "^1.5.4",
    "sass": "^1.99.0",
    "typescript": "^5.8.2",
    "vite": "^7.3.6",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.8"
  },
  "overrides": {
    "@electron/get": {
      "global-agent": "4.1.3"
    }
  },
  "allowScripts": {
    "esbuild": true,
    "core-js": false,
    "electron-winstaller": false,
    "@parcel/watcher": false
  }
}
