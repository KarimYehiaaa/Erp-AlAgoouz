{
  "name": "bin-al-ajouz-erp",
  "version": "1.0.0",
  "private": true,
  "description": "بن العجوز ERP",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "tsx backend/src/index.ts",
    "start:prod": "node backend/src/index.js",
    "build": "cd frontend && npx vite build --outDir ../dist",
    "setup": "node scripts/setup-project.js",
    "backup": "node scripts/backup-system.js",
    "update": "node scripts/update-project.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop bin-al-ajouz-api bin-al-ajouz-web",
    "pm2:logs": "pm2 logs",
    "lint": "eslint backend/src frontend/src",
    "lint:fix": "eslint --fix backend/src frontend/src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "backend/src/**/*.{js,ts,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "frontend/src/**/*.{vue,js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,css,scss,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "type": "module",
  "dependencies": {
    "@sentry/node": "^10.69.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.0.9",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.0",
    "pg": "^8.12.0",
    "selfsigned": "^5.5.0",
    "tsx": "^4.23.11",
    "uuid": "^11.1.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.11",
    "typescript-eslint": "^8.66.0"
  }
}
