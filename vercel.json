{
  "version": 2,
  "builds": [
    {
      "src": "backend/src/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/src/index.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "frontend/dist/assets/\"
    },
    {
      "src": "/logo.png",
      "dest": "frontend/dist/logo.png"
    },
    {
      "src": "/manifest.json",
      "dest": "frontend/dist/manifest.json"
    },
    {
      "src": "/sw.js",
      "dest": "frontend/dist/sw.js"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/dist/index.html"
    }
  ]
}
