[TEMPLATE]
PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=bin_al_ajouz
DB_USER=erp_user
DB_PASSWORD=replace_with_strong_password

JWT_SECRET=replace_with_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=8h

CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

COMPANY_NAME=Bin Al-Ajouz

# ── الذكاء الاصطناعي (المساعد الذكي / الدردشة التفاعلية) ──
# مفتاح Google Gemini API — احصل عليه مجانًا من:
#   https://aistudio.google.com/apikey
# ثم الصقه هنا (بدون علامات اقتباس). بدون هذا المفتاح يعمل النظام كاملًا
# ما عدا المساعد الذكي والدردشة التفاعلية.
GEMINI_API_KEY=
# النموذج المستخدم (اختياري — الافتراضي gemini-2.5-flash).
GEMINI_MODEL=gemini-3.5-flash

# Set to 1 only when running DB-mutating integration tests against a disposable database.
RUN_DB_INTEGRATION_TESTS=0

# Optional backup controls for tests/maintenance.
AUTO_BACKUP_DIR=
AUTO_BACKUP_SKIP_CLEANUP=0
AUTO_BACKUP_SKIP_EXTERNAL=0
