{
  "functions": {
    "api/**/*": {
      "maxDuration": 30,
      "includeFiles": "{migrations/*.sql,certs/prod-ca-2021.crt,../assets/logo.png}"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ]
}
