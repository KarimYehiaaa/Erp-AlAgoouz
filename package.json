{
  "name": "bin-al-ajouz-erp",
  "version": "1.0.0",
  "private": true,
  "description": "بن العجوز ERP",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev -w backend",
    "start": "npm run start -w backend",
    "start:prod": "npm run start -w backend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "test": "npm run test:local -w backend && npm run test:unit -w frontend",
    "check:local": "npm run typecheck -w backend && npm run check:scripts -w backend && npm run test:local -w backend && node scripts/check-build-path.ts",
    "build": "npm run build -w frontend",
    "setup": "node scripts/setup-project.ts",
    "backup": "node scripts/backup-system.ts",
    "update": "node scripts/update-project.ts",
    "kill:port": "node scripts/kill-port.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop bin-al-ajouz-erp",
    "pm2:logs": "pm2 logs bin-al-ajouz-erp",
    "lint": "eslint backend/src frontend/src",
    "lint:fix": "eslint --fix backend/src frontend/src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "backend/src/**/*.{js,ts,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "frontend/src/**/*.{vue,js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "{backend,frontend}/src/**/*.{json,css,scss}": [
      "prettier --write"
    ]
  },
  "type": "module",
  "dependencies": {
    "@sentry/node": "^10.69.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.0.9",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.12.0",
    "selfsigned": "^5.5.0",
    "tsx": "^4.23.11",
    "uuid": "^11.1.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.11",
    "typescript-eslint": "^8.66.0"
  }
}
