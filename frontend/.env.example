# Frontend build configuration only. Never put secrets in VITE_ variables.
# Leave empty to use the web page's own API; Android defaults to the hosted ERP.
VITE_API_URL=
# Additional trusted HTTPS origins, including their ports, separated by commas.
# Use root origins only: no /api/v1 path, credentials, query or fragment.
# Example: https://erp.example.com,https://erp.example.com:3443
VITE_TRUSTED_SERVER_URLS=
